<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.Date" %>
<%
    // Session Tracking: Track individual user visits
    Integer visitCount = (Integer) session.getAttribute("visitCount");
    if (visitCount == null) {
        visitCount = 1;
    } else {
        visitCount++;
    }
    session.setAttribute("visitCount", visitCount);

    // Application Scope Tracking: Track global website visits
    Integer globalVisitors = (Integer) application.getAttribute("globalVisitors");
    if (globalVisitors == null) {
        globalVisitors = 1;
    } else {
        synchronized (application) {
            globalVisitors = (Integer) application.getAttribute("globalVisitors");
            globalVisitors++;
            application.setAttribute("globalVisitors", globalVisitors);
        }
    }
    application.setAttribute("globalVisitors", globalVisitors);

    // General session state check for nav
    String usernameNav = (String) session.getAttribute("sessionUser");
    boolean isLoggedInNav = (usernameNav != null);
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JSP Implicit Objects (Q13) | DermAnalysis</title>
    <link rel="stylesheet" href="css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <div class="container">
        
        <!-- Navigation -->
        <nav class="nav-bar">
            <div class="nav-logo">
                <span>Derm</span>Analysis
            </div>
            <ul class="nav-links">
                <li><a href="index.jsp">Dashboard</a></li>
                <li><a href="AnalysisServlet?action=list">Disease Analysis</a></li>
                <li><a href="StudentServlet?action=list">Student Database (Q6)</a></li>
                <li><a href="lifecycle.jsp">Servlet Lifecycle (Q1)</a></li>
                <% if (isLoggedInNav) { %>
                    <li><a href="WelcomeServlet">Session Compare (Q5)</a></li>
                    <li><a href="login.html" class="text-highlight">Switch User</a></li>
                <% } else { %>
                    <li><a href="login.html" class="text-highlight">Login / Signup</a></li>
                <% } %>
            </ul>
        </nav>

        <header>
            <h1 class="glow-text">Implicit Objects & Session State</h1>
            <p class="subtitle">Assignment Q13: JSP program using Implicit Objects and Session Tracking</p>
        </header>

        <!-- Metric Counter Panel -->
        <div class="grid-3 mb-20">
            <div class="card glass-card hover-glow text-center">
                <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Your Session Visits</span>
                <h2 style="font-size: 2.5rem; color: var(--accent-secondary); margin-top: 10px;"><%= visitCount %></h2>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin-top: 5px;">Increments when you refresh this page</p>
            </div>
            <div class="card glass-card hover-glow text-center">
                <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Global App Visits</span>
                <h2 style="font-size: 2.5rem; color: var(--accent-primary); margin-top: 10px;"><%= globalVisitors %></h2>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin-top: 5px;">Shared across all users of the application</p>
            </div>
            <div class="card glass-card hover-glow text-center">
                <span style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Session Status</span>
                <h2 style="font-size: 1.5rem; color: var(--accent-success); margin-top: 20px;">
                    <%= session.isNew() ? "New Session" : "Active & Tracked" %>
                </h2>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin-top: 5px;">Session ID generated by container</p>
            </div>
        </div>

        <div class="card glass-card">
            <h2>Demonstration of JSP Implicit Objects</h2>
            <p style="color: var(--text-muted); font-size: 0.82rem; margin-bottom: 20px;">
                Implicit objects are Java objects that the JSP container makes available to developers automatically on every page.
            </p>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 20%;">Implicit Object</th>
                            <th style="width: 30%;">Class Type</th>
                            <th style="width: 50%;">Sample Data Fetched</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 1. request -->
                        <tr>
                            <td><b>request</b></td>
                            <td><code><%= request.getClass().getName() %></code></td>
                            <td>
                                <b>Method:</b> <%= request.getMethod() %><br>
                                <b>URI:</b> <%= request.getRequestURI() %><br>
                                <b>Protocol:</b> <%= request.getProtocol() %><br>
                                <b>User-Agent:</b> <%= request.getHeader("User-Agent") %>
                            </td>
                        </tr>
                        <!-- 2. response -->
                        <tr>
                            <td><b>response</b></td>
                            <td><code><%= response.getClass().getName() %></code></td>
                            <td>
                                <b>Locale:</b> <%= response.getLocale() %><br>
                                <b>Content Type:</b> <%= response.getContentType() %><br>
                                <b>Buffer Size:</b> <%= response.getBufferSize() %> bytes
                            </td>
                        </tr>
                        <!-- 3. session -->
                        <tr>
                            <td><b>session</b></td>
                            <td><code><%= session.getClass().getName() %></code></td>
                            <td>
                                <b>Session ID:</b> <span class="text-highlight" style="font-family: monospace; font-size: 0.85rem;"><%= session.getId() %></span><br>
                                <b>Created At:</b> <%= new Date(session.getCreationTime()) %><br>
                                <b>Last Accessed:</b> <%= new Date(session.getLastAccessedTime()) %><br>
                                <b>Max Inactive Interval:</b> <%= session.getMaxInactiveInterval() %> seconds
                            </td>
                        </tr>
                        <!-- 4. application -->
                        <tr>
                            <td><b>application</b></td>
                            <td><code><%= application.getClass().getName() %></code></td>
                            <td>
                                <b>Server Info:</b> <%= application.getServerInfo() %><br>
                                <b>Context Path:</b> <%= application.getContextPath() %><br>
                                <b>JSP Version:</b> <%= application.getMajorVersion() %>.<%= application.getMinorVersion() %>
                            </td>
                        </tr>
                        <!-- 5. out -->
                        <tr>
                            <td><b>out</b></td>
                            <td><code><%= out.getClass().getName() %></code></td>
                            <td>
                                <b>Remaining Buffer:</b> <%= out.getRemaining() %> bytes<br>
                                <b>Auto Flush:</b> <%= out.isAutoFlush() %><br>
                                <% out.print("<i>(This text was printed directly using out.print() statement!)</i>"); %>
                            </td>
                        </tr>
                        <!-- 6. config -->
                        <tr>
                            <td><b>config</b></td>
                            <td><code><%= config.getClass().getName() %></code></td>
                            <td>
                                <b>Servlet Name:</b> <%= config.getServletName() %><br>
                                <b>Initialization Params:</b> No context-params configured.
                            </td>
                        </tr>
                        <!-- 7. pageContext -->
                        <tr>
                            <td><b>pageContext</b></td>
                            <td><code><%= pageContext.getClass().getName() %></code></td>
                            <td>
                                <b>Request Scope Check:</b> <%= pageContext.getAttribute("paramBean", PageContext.REQUEST_SCOPE) != null ? "ParamBean Active" : "Empty" %><br>
                                <b>Session Scope Check:</b> <%= pageContext.getAttribute("visitCount", PageContext.SESSION_SCOPE) != null ? "VisitCount Mapped" : "Empty" %>
                            </td>
                        </tr>
                        <!-- 8. page -->
                        <tr>
                            <td><b>page</b></td>
                            <td><code><%= page.getClass().getName() %></code></td>
                            <td>
                                <b>Compiled Servlet Instance:</b> <%= page.toString() %>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script src="js/app.js"></script>
</body>
</html>
